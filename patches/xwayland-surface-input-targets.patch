+void
+PointerRouteConstrain(DeviceIntPtr dev, SpritePtr view, DeviceEvent *event)
+{
+    GrabPtr grab = dev->deviceGrab.grab;
+    WindowPtr confine = grab && grab->confineTo ? grab->confineTo :
+                                                view->hot.pScreen->root;
+
+    /* During activation the new grab is not installed yet. A direct
+     * confinement correction must use the new bounds, not the old grab's. */
+    if (event->pointerOrigin == POINTER_ROUTE_LOGICAL_CORRECTION &&
+        dev->pointerConfinement && dev->pointerConfinement->window &&
+        dev->pointerConfinement->target.incarnation ==
+        event->pointerTarget.incarnation)
+        confine = dev->pointerConfinement->window;
+    CheckVirtualMotionSprite(dev, NULL, confine, view);
+    if (event->root_x != view->hot.x)
+        event->root_x_frac = 0;
+    if (event->root_y != view->hot.y)
+        event->root_y_frac = 0;
+    event->root_x = view->hot.x;
+    event->root_y = view->hot.y;
+}
+
+static void
+ConfineCursorToWindowInternal(DeviceIntPtr pDev, WindowPtr pWin,
