diff --git a/hw/xwayland/xwayland-input-target.c b/hw/xwayland/xwayland-input-target.c
--- a/hw/xwayland/xwayland-input-target.c
+++ b/hw/xwayland/xwayland-input-target.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: MIT */
+#include <xwayland-config.h>
+#include "xwayland-input-target.h"
+#include "xwayland-input.h"
+#include "xwayland-screen.h"
+#include "xwayland-window.h"
+#include "windowstr.h"
+#include "mi.h"
+#include "os.h"
+
+uint64_t
+xwl_input_target_allocate(struct xwl_screen *screen)
+{
+    if (!screen->next_input_target)
+        screen->next_input_target = 2;
+    if (screen->next_input_target == UINT64_MAX)
+        FatalError("Xwayland surface input target namespace exhausted\n");
+    return screen->next_input_target++;
+}
+
+static Bool
+contains_point(WindowPtr win, int x, int y)
+{
+    BoxRec box;
+
+    return win->mapped && win->realized && !win->unhittable &&
+        x >= win->drawable.x - wBorderWidth(win) &&
+        x < win->drawable.x + (int) win->drawable.width + wBorderWidth(win) &&
+        y >= win->drawable.y - wBorderWidth(win) &&
+        y < win->drawable.y + (int) win->drawable.height + wBorderWidth(win) &&
+        (!wBoundingShape(win) || PointInBorderSize(win, x, y)) &&
+        (!wInputShape(win) ||
+         RegionContainsPoint(wInputShape(win), x - win->drawable.x,
+                             y - win->drawable.y, &box));
+}
+
+static Bool
+resolve_target(ScreenPtr screen, const PointerTarget *target, SpritePtr view)
+{
+    struct xwl_screen *xwl_screen = xwl_screen_get(screen);
+    struct xwl_window *window;
+    WindowPtr top = NULL, ancestor;
+    int depth = 0, i;
+
+    xorg_list_for_each_entry(window, &xwl_screen->window_list, link_window) {
+        if (window->input_target == target->incarnation) {
+            top = window->toplevel;
+            break;
+        }
+    }
+    /* A retired surface never rebinds to an XID, another surface, or a parent. */
+    if (!top || top == screen->root)
+        return FALSE;
+    for (ancestor = top; ancestor; ancestor = ancestor->parent) {
+        if (ancestor != screen->root &&
+            !contains_point(ancestor, view->hot.x, view->hot.y))
+            return FALSE;
+        depth++;
+        if (!ancestor->parent && ancestor != screen->root)
+            return FALSE;
+    }
+    if (view->spriteTraceSize < depth) {
+        view->spriteTrace = XNFrealloc(view->spriteTrace,
+                                      depth * sizeof(WindowPtr));
+        view->spriteTraceSize = depth;
+    }
+    /* Retain the entire root/frame/target ancestry for ordinary DIX grabs.
+     * miSpriteTrace then descends only this surface's subtree, using current
+     * child stacking and shapes, without consulting overlapping root peers. */
+    for (ancestor = top, i = depth; ancestor; ancestor = ancestor->parent)
+        view->spriteTrace[--i] = ancestor;
+    view->spriteTraceGood = depth;
+    view->win = miSpriteTrace(view, view->hot.x, view->hot.y);
+    return TRUE;
+}
+
+void
+xwl_input_target_init(struct xwl_screen *screen)
+{
+    if (screen->surface_input_targets)
+        screen->screen->ResolvePointerTarget = resolve_target;
+}
+
+void
+xwl_queue_pointer_events(struct xwl_seat *seat, DeviceIntPtr dev, int type,
+                         int button, int flags, const ValuatorMask *mask)
+{
+    PointerTarget target = { 0 };
+
+    if (seat->xwl_screen->surface_input_targets) {
+        target.screen = seat->xwl_screen->screen->myNum;
+        target.incarnation = seat->focus_window && seat->focus_window->input_target ?
+                             seat->focus_window->input_target : 1;
+    }
+    /* Focus is sampled only at the producer boundary. Queued delivery and
+     * replay resolve the incarnation in the record, never this seat's focus. */
+    QueuePointerEventsWithTarget(dev, type, button, flags, mask, target,
+                                 POINTER_ROUTE_NATIVE);
+}
