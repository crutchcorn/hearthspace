+static void
+ReconcilePointerPosition(DeviceIntPtr dev, enum PointerRouteOrigin origin)
+{
+    PointerConfinementScope reconciliation;
+    SpritePtr sprite = dev->spriteInfo->sprite;
+    GrabPtr grab = dev->deviceGrab.grab;
+
+    /* Include cursor changes, and always start from latest P, never from a
+     * historical event's L/R. MI corrections update producer valuators too. */
+    PointerConfinementBegin(dev, origin, &reconciliation);
+    if (grab && grab->confineTo) {
+        if (grab->confineTo->drawable.pScreen != sprite->hotPhys.pScreen)
+            sprite->hotPhys.x = sprite->hotPhys.y = 0;
+        ConfineCursorToWindowWithRoute(dev, grab->confineTo, TRUE, TRUE, origin);
+    }
+    else
+        ConfineCursorToWindowWithRoute(dev, sprite->hotPhys.pScreen->root,
+                                      TRUE, FALSE, origin);
+    PostNewCursor(dev);
+    PointerConfinementEnd(dev, &reconciliation);
+}
+
+void
+PointerRouteReconcileInput(void)
+{
+    DeviceIntPtr dev;
+
+    if (syncEvents.playingEvents)
+        return;
+    /* MI calls this only after draining native input. P is then the latest
+     * ingress position, and no newer producer records can be overwritten by
+     * this correction. Never use an event's historical L/R to seed a warp. */
+    for (dev = inputInfo.devices; dev; dev = dev->next)
+        if (DevHasCursor(dev) && !dev->pointerRoute &&
+            !dev->deviceGrab.sync.frozen &&
+            dev->spriteInfo->sprite->physicalTarget.incarnation &&
+            dev->deviceGrab.grab && dev->deviceGrab.grab->confineTo)
+            /* Keep producer/ingress updates even when L already reached the
+             * constrained point. Only this live origin can omit redelivery. */
+            ReconcilePointerPosition(dev, POINTER_ROUTE_LIVE_CORRECTION);
+}
