+/* SPDX-License-Identifier: MIT */
+#ifdef HAVE_DIX_CONFIG_H
+#include <dix-config.h>
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+#include "os.h"
+#include "pointer-route.h"
+#include "scrnintstr.h"
+#include "windowstr.h"
+#include "inpututils.h"
+
+static Bool
+pointer_record(const InternalEvent *event)
+{
+    if (!event)
+        return FALSE;
+    switch (event->any.type) {
+    case ET_Motion:
+    case ET_ButtonPress:
+    case ET_ButtonRelease:
+    case ET_Enter:
+        return event->any.length >= sizeof(DeviceEvent);
+    default:
+        return FALSE;
+    }
+}
+
+Bool
+PointerRouteTagged(const InternalEvent *event)
+{
+    return pointer_record(event) && event->device_event.pointerTarget.incarnation;
+}
+
+void
+PointerRouteStamp(InternalEvent *events, int count, PointerTarget target,
+                  enum PointerRouteOrigin origin)
+{
+    int i;
+
+    for (i = 0; i < count; i++) {
+        if (pointer_record(&events[i])) {
+            events[i].device_event.pointerTarget = target;
+            events[i].device_event.pointerOrigin = origin;
+        }
+    }
+}
+
+static Bool
+xy_only(const DeviceEvent *event)
+{
+    int i;
+
+    if (!BitIsOn(event->valuators.mask, 0) ||
+        !BitIsOn(event->valuators.mask, 1))
+        return FALSE;
+    for (i = 2; i < MAX_VALUATORS; i++)
+        if (BitIsOn(event->valuators.mask, i))
+            return FALSE;
+    return TRUE;
+}
+
+static Bool
+absolute_xy_only(const DeviceEvent *event)
+{
+    /* Scroll and relative valuators carry deltas, not replaceable positions. */
+    return BitIsOn(event->valuators.mode, 0) &&
+           BitIsOn(event->valuators.mode, 1) && xy_only(event);
+}
+
+Bool
+PointerRouteCanCoalesce(const DeviceEvent *a, const DeviceEvent *b)
+{
+    if (!a->pointerTarget.incarnation && !b->pointerTarget.incarnation)
+        return TRUE; /* retain legacy compression */
+    return a->pointerTarget.incarnation &&
+           a->pointerTarget.incarnation == b->pointerTarget.incarnation &&
+           a->pointerTarget.screen == b->pointerTarget.screen &&
+           a->pointerOrigin == b->pointerOrigin &&
+           a->deviceid == b->deviceid && a->sourceid == b->sourceid &&
+           a->source_type == b->source_type && a->flags == b->flags &&
+           absolute_xy_only(a) && absolute_xy_only(b);
+}
+
+ScreenPtr
+PointerRouteScreen(const InternalEvent *event, ScreenPtr fallback)
+{
+    if (PointerRouteTagged(event) &&
+        event->device_event.pointerTarget.screen < screenInfo.numScreens)
+        return screenInfo.screens[event->device_event.pointerTarget.screen];
+    return fallback;
+}
+
+void
+PointerRouteIngress(DeviceIntPtr dev, InternalEvent *event)
+{
+    SpritePtr sprite;
+    DeviceEvent *ev;
+
+    if (!dev)
+        return;
+    if ((event->any.type == ET_TouchBegin || event->any.type == ET_TouchUpdate ||
+         event->any.type == ET_TouchEnd) &&
+        (event->device_event.flags & TOUCH_POINTER_EMULATED)) {
+        dev->spriteInfo->sprite->physicalTarget = (PointerTarget) { 0 };
+        return;
+    }
+    if (!pointer_record(event) || event->any.type == ET_Enter)
+        return;
+    ev = &event->device_event;
+    sprite = dev->spriteInfo->sprite;
+    if (!ev->pointerTarget.incarnation) {
+        sprite->physicalTarget = (PointerTarget) { 0 };
+        return;
+    }
+    if (ev->pointerOrigin == POINTER_ROUTE_LOGICAL_CORRECTION)
+        return;
+    /* Once per MI record, before slave/master dispatch or DIX freezing. */
+    sprite->physicalTarget = ev->pointerTarget;
+    sprite->hotPhys.pScreen = PointerRouteScreen(event, sprite->hotPhys.pScreen);
+    sprite->hotPhys.x = ev->root_x;
+    sprite->hotPhys.y = ev->root_y;
+}
+
+Bool
+PointerRouteActive(DeviceIntPtr dev)
+{
+    return dev->pointerRoute && dev->pointerRoute->target.incarnation;
+}
+
+Bool
+PointerRouteMissing(DeviceIntPtr dev)
+{
+    return PointerRouteActive(dev) && dev->pointerRoute->missing;
+}
+
+SpritePtr
+PointerDeliverySprite(DeviceIntPtr dev)
+{
+    return PointerRouteActive(dev) ? &dev->pointerRoute->sprite :
+                                    dev->spriteInfo->sprite;
+}
+
+void
+PointerRouteInvalidateCorrection(DeviceIntPtr dev)
+{
+    PointerRouteScope *scope;
+
+    for (scope = dev->pointerRoute; scope; scope = scope->previous)
+        scope->repeatCorrection = FALSE;
+}
+
+static Bool
+same_logical_view(SpritePtr a, SpritePtr b)
+{
+    return a->hot.pScreen == b->hot.pScreen &&
+           a->hot.x == b->hot.x && a->hot.y == b->hot.y &&
+           a->win == b->win && a->spriteTraceGood == b->spriteTraceGood &&
+           !memcmp(a->spriteTrace, b->spriteTrace,
+                   a->spriteTraceGood * sizeof(WindowPtr));
+}
+
+static Bool
+live_correction_matches(DeviceIntPtr dev, DeviceEvent *event)
+{
+    PointerRouteScope *scope = dev->pointerRoute;
+    SpritePtr sprite = dev->spriteInfo->sprite;
+
+    return event->type == ET_Motion &&
+           event->pointerOrigin == POINTER_ROUTE_LIVE_CORRECTION &&
+           (IsMaster(dev) || IsFloating(dev)) && DevHasCursor(dev) &&
+           !syncEvents.playingEvents && !dev->deviceGrab.sync.frozen &&
+           dev->deviceGrab.grab && dev->deviceGrab.grab->confineTo &&
+           scope && !scope->missing && scope->target.incarnation >= 2 &&
+           scope->origin == POINTER_ROUTE_LIVE_CORRECTION &&
+           event->pointerTarget.incarnation == scope->target.incarnation &&
+           event->pointerTarget.screen == scope->target.screen &&
+           sprite->logicalTarget.incarnation == scope->target.incarnation &&
+           sprite->logicalTarget.screen == scope->target.screen &&
+           event->root_x == scope->sprite.hot.x &&
+           event->root_y == scope->sprite.hot.y &&
+           !event->root_x_frac && !event->root_y_frac &&
+           /* Live corrections are absolute MI warps even when the device's
+            * valuator modes (copied into the event) describe relative axes. */
+           xy_only(event) && same_logical_view(sprite, &scope->sprite);
+}
+
+void
+PointerRoutePrepareLiveCorrection(DeviceIntPtr dev, DeviceEvent *event)
+{
+    PointerRouteScope *scope = dev->pointerRoute;
+
+    if (!scope)
+        return;
+    /* Compare to L BEFORE CheckMotion publishes this correction. Comparing
+     * only afterwards would also suppress genuine routing/position changes. */
+    scope->repeatCorrection = live_correction_matches(dev, event);
+    scope->logicalSprite = dev->spriteInfo->sprite;
+    scope->logicalRevision = scope->logicalSprite->routeRevision;
+}
+
+Bool
+PointerRouteSuppressLiveCorrection(DeviceIntPtr dev, DeviceEvent *event)
+{
+    PointerRouteScope *scope = dev->pointerRoute;
+    SpritePtr sprite = dev->spriteInfo->sprite;
+    SpriteRec current;
+    DeviceEvent check;
+    ScreenPtr screen;
+    Bool same;
+
+    if (!scope || !scope->repeatCorrection || scope->logicalSprite != sprite ||
+        sprite->routeRevision != scope->logicalRevision + 1 ||
+        !live_correction_matches(dev, event))
+        return FALSE;
+    /* Only our one CheckMotion publication is allowed. Nested dispatch and
+     * grab changes invalidate the candidate; re-resolve lifetime/ancestry too
+     * in case a callback changed the target's mapping, shape or child stack. */
+    memset(&current, 0, sizeof(current));
+    check = *event;
+    current.hot = scope->sprite.hot;
+    current.spriteTrace = XNFalloc(sizeof(WindowPtr));
+    current.spriteTraceSize = current.spriteTraceGood = 1;
+    current.spriteTrace[0] = current.hot.pScreen->root;
+    PointerRouteConstrain(dev, &current, &check);
+    screen = current.hot.pScreen;
+    current.hotPhys = current.hot;
+#ifdef PANORAMIX
+    current.screen = screen;
+#endif
+    current.win = screen->root;
+    same = screen->ResolvePointerTarget &&
+           scope->target.screen == screen->myNum &&
+           screen->ResolvePointerTarget(screen, &scope->target, &current) &&
+           same_logical_view(&current, &scope->sprite);
+    free(current.spriteTrace);
+    return same && scope->repeatCorrection &&
+           sprite == dev->spriteInfo->sprite &&
+           sprite->routeRevision == scope->logicalRevision + 1 &&
+           live_correction_matches(dev, event);
+}
+
+void
+PointerRouteBegin(DeviceIntPtr dev, InternalEvent *event, PointerRouteScope *scope)
+{
+    SpritePtr view = &scope->sprite;
+    ScreenPtr screen;
+    DeviceEvent *ev;
+
+    PointerRouteInvalidateCorrection(dev);
+    memset(scope, 0, sizeof(*scope));
+    scope->previous = dev->pointerRoute;
+    /* Even an untagged nested dispatch installs an explicit legacy sentinel. */
+    dev->pointerRoute = scope;
+    if (!PointerRouteTagged(event))
+        return;
+    ev = &event->device_event;
+    scope->target = ev->pointerTarget;
+    scope->origin = ev->pointerOrigin;
+    screen = PointerRouteScreen(event, dev->spriteInfo->sprite->hot.pScreen);
+    view->hot.pScreen = screen;
+    view->hot.x = ev->root_x;
+    view->hot.y = ev->root_y;
+    view->spriteTrace = XNFalloc(sizeof(WindowPtr));
+    view->spriteTraceSize = view->spriteTraceGood = 1;
+    view->spriteTrace[0] = screen->root;
+    PointerRouteConstrain(dev, view, ev);
+    screen = view->hot.pScreen;
+    view->hotPhys = view->hot;
+#ifdef PANORAMIX
+    view->screen = screen;
+#endif
+    view->win = screen->root;
+    view->spriteTrace[0] = screen->root;
+    scope->missing = scope->target.incarnation == 1 ||
+                     scope->target.screen != screen->myNum ||
+                     !screen->ResolvePointerTarget ||
+                     !screen->ResolvePointerTarget(screen, &scope->target, view);
+    if (scope->missing) {
+        view->win = screen->root;
+        view->spriteTraceGood = 1;
+    }
+    ev->root = screen->root->drawable.id;
+}
+
+void
+PointerRouteBeginLogical(DeviceIntPtr dev, PointerRouteScope *scope)
+{
+    SpritePtr sprite = dev->spriteInfo->sprite;
+    InternalEvent event = { 0 };
+
+    init_device_event(&event.device_event, dev, 0, EVENT_SOURCE_NORMAL);
+    event.device_event.type = ET_Motion;
+    event.device_event.pointerTarget = sprite->logicalTarget;
+    event.device_event.pointerOrigin = POINTER_ROUTE_LOGICAL_CORRECTION;
+    event.device_event.root_x = sprite->hot.x;
+    event.device_event.root_y = sprite->hot.y;
+    PointerRouteBegin(dev, &event, scope);
+}
+
+void
+PointerRouteEnd(DeviceIntPtr dev, PointerRouteScope *scope)
+{
+    dev->pointerRoute = scope->previous;
+    free(scope->sprite.spriteTrace);
+}
+
+uint64_t
+PointerRoutePublish(DeviceIntPtr dev, Bool publishWindow)
+{
+    SpritePtr sprite = dev->spriteInfo->sprite;
+    SpritePtr view = PointerDeliverySprite(dev);
+    size_t size;
+
+    if (!PointerRouteActive(dev))
+        return sprite->routeRevision;
+    size = view->spriteTraceGood * sizeof(WindowPtr);
+    if (sprite->spriteTraceSize < view->spriteTraceGood) {
+        sprite->spriteTrace = XNFrealloc(sprite->spriteTrace, size);
+        sprite->spriteTraceSize = view->spriteTraceGood;
+    }
+    memcpy(sprite->spriteTrace, view->spriteTrace, size);
+    sprite->spriteTraceGood = view->spriteTraceGood;
+    sprite->hot = view->hot;
+    sprite->logicalTarget = dev->pointerRoute->target;
+    if (publishWindow)
+        sprite->win = view->win;
+    /* Never copy hotPhys or ownership-bearing Sprite fields from a view. */
+    return ++sprite->routeRevision;
+}
+
+void
+PointerConfinementBegin(DeviceIntPtr dev, enum PointerRouteOrigin origin,
+                        PointerConfinementScope *scope)
+{
+    SpritePtr sprite = dev->spriteInfo->sprite;
+
+    scope->previous = dev->pointerConfinement;
+    scope->origin = origin;
+    scope->window = NULL;
+    if (origin == POINTER_ROUTE_PHYSICAL_CORRECTION ||
+        origin == POINTER_ROUTE_LIVE_CORRECTION) {
+        scope->target = sprite->physicalTarget;
+        scope->position = sprite->hotPhys;
+    }
+    else if (dev->pointerRoute) {
+        /* A legacy dispatch is a boundary too: do not inherit stale L. */
+        scope->target = dev->pointerRoute->target;
+        scope->position = PointerDeliverySprite(dev)->hot;
+    }
+    else {
+        scope->target = sprite->logicalTarget;
+        scope->position = sprite->hot;
+    }
+    dev->pointerConfinement = scope;
+}
+
+void
+PointerConfinementEnd(DeviceIntPtr dev, PointerConfinementScope *scope)
+{
+    dev->pointerConfinement = scope->previous;
+}
