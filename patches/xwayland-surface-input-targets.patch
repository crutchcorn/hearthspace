+
+static void
+ConfineCursorToWindowWithRoute(DeviceIntPtr dev, WindowPtr win,
+                              Bool generateEvents, Bool confineToScreen,
+                              enum PointerRouteOrigin origin)
+{
+    PointerConfinementScope scope;
+    SpritePtr sprite = dev->spriteInfo->sprite;
+    ScreenPtr screen = win->drawable.pScreen;
+
+    PointerConfinementBegin(dev, origin, &scope);
+    scope.window = win;
+    if (scope.target.incarnation && origin == POINTER_ROUTE_LOGICAL_CORRECTION) {
+        WindowPtr root = scope.position.pScreen->root;
+        SpriteRec view = { .hot = scope.position, .spriteTrace = &root };
+
+        /* Confinement can reenter dispatch. Never edit the outer delivery view
+         * or move the physical position back to a frozen logical position. */
+        CheckVirtualMotionSprite(dev, NULL, win, &view);
+        sprite->hotLimits = *RegionExtents(&win->borderSize);
+        sprite->hotShape = wBoundingShape(win) ? &win->borderSize : NullRegion;
+        sprite->confined = confineToScreen;
+        if (sprite->current) {
+            (*screen->CursorLimits)(dev, screen, sprite->current,
+                                   &sprite->hotLimits, &sprite->physLimits);
+            (*screen->ConstrainCursor)(dev, screen, &sprite->physLimits);
+        }
+        if (view.hot.x != scope.position.x || view.hot.y != scope.position.y ||
+            view.hot.pScreen != scope.position.pScreen)
+            SyntheticMotion(dev, view.hot.x, view.hot.y);
+        if (screen->CursorConfinedTo)
+            (*screen->CursorConfinedTo)(dev, screen, win);
+    }
+    else
+        ConfineCursorToWindowInternal(dev, win, generateEvents, confineToScreen);
+    PointerConfinementEnd(dev, &scope);
+}
+
+static void
+ConfineCursorToWindow(DeviceIntPtr dev, WindowPtr win, Bool generateEvents,
+                     Bool confineToScreen)
+{
+    /* Requests outside dispatch explicitly use L, never the latest seat focus. */
+    ConfineCursorToWindowWithRoute(dev, win, generateEvents, confineToScreen,
+                                  POINTER_ROUTE_LOGICAL_CORRECTION);
 }

