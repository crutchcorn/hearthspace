+  <interface name="xwayland_satellite_overlay_v1" version="1">
+    <description summary="private X11 screen-overlay metadata">
+      Restricted to the compositor's X11 bridge. Mark an unmapped toplevel as
+      an output-space overlay. The compositor owns placement and focus policy.
+      Application identity is unchanged. No privilege over a session lock is granted.
+    </description>
+    <request name="destroy" type="destructor"/>
+    <request name="set_overlay">
+      <arg name="toplevel" type="object" interface="xdg_toplevel"/>
+      <arg name="output_name" type="string" summary="wl_output name, empty for compositor default"/>
+      <arg name="corner" type="uint" summary="0 top-left, 1 top-right, 2 bottom-left, 3 bottom-right"/>
+    </request>
+  </interface>
+</protocol>
