diff --git a/src/xstate/selection/dnd.rs b/src/xstate/selection/dnd.rs
--- /dev/null
+++ b/src/xstate/selection/dnd.rs
@@ -0,0 +1,326 @@
+//! Copy-only host URI drags. Each drag owns a distinct X selection window.
+mod events;
+use super::{
+    Clipboard, CurrentSelection, ForeignSelection, SelectionData, SelectionDataImpl,
+    SelectionTargetId, WaylandSelection,
+};
+use crate::{RealServerState, server::drag::Event, xstate::XState};
+use log::warn;
+use smithay_client_toolkit::data_device_manager::data_offer::DragOffer;
+use wayland_client::{Proxy, protocol::wl_data_device_manager::DndAction};
+use xcb::{Xid, x};
+
+xcb::atoms_struct! {
+    #[derive(Clone)]
+    struct Atoms {
+        aware => b"XdndAware" only_if_exists = false,
+        enter => b"XdndEnter" only_if_exists = false,
+        position => b"XdndPosition" only_if_exists = false,
+        status => b"XdndStatus" only_if_exists = false,
+        leave => b"XdndLeave" only_if_exists = false,
+        drop => b"XdndDrop" only_if_exists = false,
+        finished => b"XdndFinished" only_if_exists = false,
+        selection => b"XdndSelection" only_if_exists = false,
+        copy => b"XdndActionCopy" only_if_exists = false,
+        types => b"XdndTypeList" only_if_exists = false,
+        uri => b"text/uri-list" only_if_exists = false,
+    }
+}
+
+pub(crate) struct State {
+    atoms: Atoms,
+    session: Option<Session>,
+}
+impl State {
+    pub(crate) fn new(connection: &xcb::Connection) -> Self {
+        Self {
+            atoms: Atoms::intern_all(connection).unwrap(),
+            session: None,
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Position {
+    packed: u32,
+    time: u32,
+}
+impl Position {
+    fn new(offer: &DragOffer, scale: f64, origin: (i16, i16)) -> Self {
+        let x = (f64::from(origin.0) + offer.x * scale).round() as i16 as u16;
+        let y = (f64::from(origin.1) + offer.y * scale).round() as i16 as u16;
+        Self {
+            packed: (u32::from(x) << 16) | u32::from(y),
+            time: offer.time.unwrap_or(x::CURRENT_TIME),
+        }
+    }
+}
+
+struct Session {
+    source: x::Window,
+    target: x::Window,
+    version: u32,
+    offer: DragOffer,
+    selection: SelectionData<Clipboard>,
+    position: Position,
+    queued: Option<Position>,
+    awaiting_status: bool,
+    accepted: bool,
+    drop_pending: bool,
+    dropped: bool,
+}
+
+fn send(
+    connection: &xcb::Connection,
+    destination: x::Window,
+    atom: x::Atom,
+    data: [u32; 5],
+) -> Result<(), xcb::Error> {
+    Ok(connection.send_and_check_request(&x::SendEvent {
+        propagate: false,
+        destination: x::SendEventDest::Window(destination),
+        event_mask: x::EventMask::empty(),
+        event: &x::ClientMessageEvent::new(destination, atom, x::ClientMessageData::Data32(data)),
+    })?)
+}
+
+fn position(
+    connection: &xcb::Connection,
+    atoms: &Atoms,
+    session: &mut Session,
+    point: Position,
+) -> Result<(), xcb::Error> {
+    if session.awaiting_status {
+        session.queued = Some(point);
+        return Ok(());
+    }
+    session.position = point;
+    session.awaiting_status = true;
+    send(
+        connection,
+        session.target,
+        atoms.position,
+        [
+            session.source.resource_id(),
+            0,
+            point.packed,
+            point.time,
+            atoms.copy.resource_id(),
+        ],
+    )
+}
+
+/// Returns true when a rejected pending drop should retire the session.
+fn drop_ready(
+    connection: &xcb::Connection,
+    atoms: &Atoms,
+    session: &mut Session,
+) -> Result<bool, xcb::Error> {
+    if !session.drop_pending || session.awaiting_status || session.dropped {
+        return Ok(false);
+    }
+    if !session.accepted {
+        return Ok(true);
+    }
+    send(
+        connection,
+        session.target,
+        atoms.drop,
+        [session.source.resource_id(), 0, session.position.time, 0, 0],
+    )?;
+    session.dropped = true;
+    Ok(false)
+}
+
+impl XState {
+    pub(crate) fn handle_host_drag(&mut self, server: &mut RealServerState) {
+        for event in server.take_drag_events() {
+            if let Err(error) = self.host_drag_event(event, server) {
+                warn!("Could not bridge host file drag: {error}");
+                self.end_host_drag(true);
+            }
+        }
+    }
+
+    fn host_drag_event(
+        &mut self,
+        event: Event,
+        server: &RealServerState,
+    ) -> Result<(), xcb::Error> {
+        match event {
+            Event::Enter(offer) => {
+                self.end_host_drag(true);
+                let Some((target, scale, origin)) = server.drag_target(&offer) else {
+                    return Ok(());
+                };
+                let uri =
+                    offer.with_mime_types(|mimes| mimes.iter().any(|mime| mime == "text/uri-list"));
+                if !uri || !offer.source_actions.contains(DndAction::Copy) {
+                    return Ok(());
+                }
+                let atoms = &self.drag.atoms;
+                let aware = self
+                    .connection
+                    .wait_for_reply(self.connection.send_request(&x::GetProperty {
+                        delete: false,
+                        window: target,
+                        property: atoms.aware,
+                        r#type: x::ATOM_ATOM,
+                        long_offset: 0,
+                        long_length: 1,
+                    }))?;
+                if aware.format() != 32 {
+                    return Ok(());
+                }
+                let Some(&version) = aware.value::<u32>().first() else {
+                    return Ok(());
+                };
+                if version < 2 {
+                    return Ok(());
+                }
+                let version = version.min(5);
+                let source = self.connection.generate_id();
+                self.connection.send_and_check_request(&x::CreateWindow {
+                    depth: 0,
+                    wid: source,
+                    parent: self.root,
+                    x: 0,
+                    y: 0,
+                    width: 1,
+                    height: 1,
+                    border_width: 0,
+                    class: x::WindowClass::InputOnly,
+                    visual: x::COPY_FROM_PARENT,
+                    value_list: &[],
+                })?;
+                let mut selection = SelectionData::new(atoms.selection, self.atoms.targets);
+                selection.current_selection = Some(CurrentSelection::Wayland(WaylandSelection {
+                    mimes: vec![SelectionTargetId {
+                        name: "text/uri-list".into(),
+                        target: atoms.uri,
+                        property: atoms.uri,
+                        source: None,
+                    }],
+                    inner: ForeignSelection::from_drag(offer.clone()),
+                    incr_data: None,
+                }));
+                let point = Position::new(&offer, scale, origin);
+                self.drag.session = Some(Session {
+                    source,
+                    target,
+                    version,
+                    offer,
+                    selection,
+                    position: point,
+                    queued: None,
+                    awaiting_status: false,
+                    accepted: false,
+                    drop_pending: false,
+                    dropped: false,
+                });
+                let session = self.drag.session.as_ref().unwrap();
+                if !session.selection.set_owner(&self.connection, source) {
+                    self.end_host_drag(false);
+                    return Ok(());
+                }
+                self.connection.send_and_check_request(&x::ChangeProperty {
+                    mode: x::PropMode::Replace,
+                    window: source,
+                    property: atoms.types,
+                    r#type: x::ATOM_ATOM,
+                    data: &[atoms.uri],
+                })?;
+                send(
+                    &self.connection,
+                    target,
+                    atoms.enter,
+                    [
+                        source.resource_id(),
+                        version << 24,
+                        atoms.uri.resource_id(),
+                        0,
+                        0,
+                    ],
+                )?;
+                position(
+                    &self.connection,
+                    &self.drag.atoms,
+                    self.drag.session.as_mut().unwrap(),
+                    point,
+                )?;
+            }
+            Event::Motion(offer) => {
+                let Some((target, scale, origin)) = server.drag_target(&offer) else {
+                    return Ok(());
+                };
+                let Some(session) = self.drag.session.as_mut() else {
+                    return Ok(());
+                };
+                if session.target == target && session.offer == offer && !session.drop_pending {
+                    position(
+                        &self.connection,
+                        &self.drag.atoms,
+                        session,
+                        Position::new(&offer, scale, origin),
+                    )?;
+                }
+            }
+            Event::Drop(offer) => {
+                let Some(session) = self.drag.session.as_mut() else {
+                    return Ok(());
+                };
+                if session.offer != offer || session.dropped {
+                    return Ok(());
+                }
+                session.offer = offer.clone();
+                if let Some(selection) = session.selection.wayland_selection_mut() {
+                    selection.inner = ForeignSelection::from_drag(offer);
+                }
+                session.drop_pending = true;
+                if drop_ready(&self.connection, &self.drag.atoms, session)? {
+                    self.end_host_drag(true);
+                }
+            }
+            Event::Leave => {
+                // Leave follows drop, too. A dropped offer remains valid until
+                // its exact X target finishes; an ordinary leave cancels it.
+                if self.drag.session.as_ref().is_some_and(|s| !s.drop_pending) {
+                    self.end_host_drag(true);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn end_host_drag(&mut self, leave: bool) {
+        let Some(session) = self.drag.session.take() else {
+            return;
+        };
+        if leave && !session.dropped {
+            let _ = send(
+                &self.connection,
+                session.target,
+                self.drag.atoms.leave,
+                [session.source.resource_id(), 0, 0, 0, 0],
+            );
+        }
+        if session.offer.inner().is_alive() {
+            if session.drop_pending {
+                session.offer.destroy();
+            } else {
+                // SCTK owns undropped offers until host leave. Revoke the
+                // acceptance now; destroying it alone leaves the host's shared
+                // offer state accepted and can race SCTK's leave cleanup.
+                session.offer.accept_mime_type(session.offer.serial, None);
+                session
+                    .offer
+                    .set_actions(DndAction::empty(), DndAction::empty());
+            }
+        }
+        // Destroying this incarnation clears selection ownership only if it
+        // still owns it; it cannot clear a newer client/drag's claim.
+        let _ = self.connection.send_and_check_request(&x::DestroyWindow {
+            window: session.source,
+        });
+    }
+}
diff --git a/src/xstate/selection/dnd/events.rs b/src/xstate/selection/dnd/events.rs
--- /dev/null
+++ b/src/xstate/selection/dnd/events.rs
@@ -0,0 +1,150 @@
+use super::*;
+
+impl XState {
+    pub(crate) fn handle_drag_event(
+        &mut self,
+        event: &xcb::Event,
+        server: &mut RealServerState,
+    ) -> bool {
+        let result = self.drag_x_event(event, server);
+        match result {
+            Ok(handled) => handled,
+            Err(error) => {
+                warn!("Could not complete host file drag: {error}");
+                self.end_host_drag(true);
+                true
+            }
+        }
+    }
+
+    fn drag_x_event(
+        &mut self,
+        event: &xcb::Event,
+        server: &mut RealServerState,
+    ) -> Result<bool, xcb::Error> {
+        let atoms = &self.drag.atoms;
+        match event {
+            xcb::Event::X(x::Event::ClientMessage(message))
+                if message.r#type() == atoms.status || message.r#type() == atoms.finished =>
+            {
+                let x::ClientMessageData::Data32(data) = message.data() else {
+                    return Ok(true);
+                };
+                let Some(session) = self.drag.session.as_mut() else {
+                    return Ok(true);
+                };
+                if message.window() != session.source || data[0] != session.target.resource_id() {
+                    return Ok(true);
+                }
+                if message.r#type() == atoms.status {
+                    if !session.awaiting_status || session.dropped {
+                        return Ok(true);
+                    }
+                    session.awaiting_status = false;
+                    session.accepted = data[1] & 1 != 0 && data[4] == atoms.copy.resource_id();
+                    let action = if session.accepted {
+                        DndAction::Copy
+                    } else {
+                        DndAction::empty()
+                    };
+                    // Wayland forbids renegotiating ordinary Copy after
+                    // drop. Resolve any outstanding X status before sending
+                    // XdndDrop, without changing the already-dropped offer.
+                    if !session.drop_pending {
+                        session.offer.set_actions(action, action);
+                        session.offer.accept_mime_type(
+                            session.offer.serial,
+                            session.accepted.then(|| "text/uri-list".into()),
+                        );
+                    }
+                    if let Some(point) = session.queued.take() {
+                        position(&self.connection, atoms, session, point)?;
+                    } else if drop_ready(&self.connection, atoms, session)? {
+                        self.end_host_drag(true);
+                    }
+                } else if session.dropped {
+                    let success = session.version < 5
+                        || (data[1] & 1 != 0 && data[2] == atoms.copy.resource_id());
+                    if success && session.offer.inner().is_alive() {
+                        session.offer.finish();
+                    }
+                    self.end_host_drag(false);
+                }
+                Ok(true)
+            }
+            xcb::Event::X(x::Event::SelectionRequest(request))
+                if request.selection() == atoms.selection =>
+            {
+                let mut accepted = false;
+                if request.property() != x::ATOM_NONE {
+                    if let Some(session) = self.drag.session.as_mut() {
+                        // A queued request addressed to an old source must not
+                        // fetch the active generation's files.
+                        if request.owner() == session.source {
+                            accepted = session.selection.handle_selection_request(
+                                &self.connection,
+                                &self.atoms,
+                                request,
+                                self.max_req_bytes.min(64 * 1024),
+                                server,
+                            );
+                        }
+                    }
+                }
+                self.connection.send_and_check_request(&x::SendEvent {
+                    propagate: false,
+                    destination: x::SendEventDest::Window(request.requestor()),
+                    event_mask: x::EventMask::empty(),
+                    event: &x::SelectionNotifyEvent::new(
+                        request.time(),
+                        request.requestor(),
+                        request.selection(),
+                        request.target(),
+                        if accepted {
+                            request.property()
+                        } else {
+                            x::ATOM_NONE
+                        },
+                    ),
+                })?;
+                Ok(true)
+            }
+            xcb::Event::X(x::Event::PropertyNotify(property))
+                if property.state() == x::Property::Delete =>
+            {
+                let handled = self
+                    .drag
+                    .session
+                    .as_mut()
+                    .and_then(|session| session.selection.wayland_selection_mut())
+                    .is_some_and(|selection| selection.check_for_incr(property, &self.connection));
+                Ok(handled)
+            }
+            xcb::Event::X(x::Event::SelectionClear(clear))
+                if clear.selection() == atoms.selection =>
+            {
+                if self
+                    .drag
+                    .session
+                    .as_ref()
+                    .is_some_and(|s| clear.owner() == s.source)
+                {
+                    self.end_host_drag(true);
+                }
+                Ok(true)
+            }
+            xcb::Event::X(x::Event::DestroyNotify(destroy)) => {
+                if self
+                    .drag
+                    .session
+                    .as_ref()
+                    .is_some_and(|s| destroy.window() == s.target)
+                {
+                    self.end_host_drag(false);
+                }
+                Ok(false) // Ordinary window teardown still belongs to XState.
+            }
+            _ => Ok(false),
+        }
+    }
+}
