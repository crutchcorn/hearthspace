+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+  <interface name="xwayland_satellite_interaction_v1" version="1">
+    <description summary="optional cancellation of an accepted interactive operation">
+      Experimental, private extension for an X11 compatibility bridge. Absence
+      leaves xdg-shell move/resize available, without cancellation forwarding.
+      The compositor may restrict this global to its authenticated bridge.
+      This extension does not grant authority to start an interaction.
+    </description>
+    <request name="destroy" type="destructor"/>
+    <request name="cancel">
+      <description summary="stop geometry changes for this exact interaction">
+        Cancel only a currently active move or resize previously accepted from
+        this toplevel, seat and initiating input serial. Unknown, stale, rejected
+        or completed operations are ignored. Retain the geometry reached so far,
+        including anchoring of outstanding resize buffers. Remaining buttons or
+        touch contacts stay owned by the cancelled sequence until they drain;
+        cancellation must not deliver an unmatched release to another surface.
+      </description>
+      <arg name="toplevel" type="object" interface="xdg_toplevel"/>
+      <arg name="seat" type="object" interface="wl_seat"/>
+      <arg name="serial" type="uint" summary="serial used for the accepted xdg-shell move or resize"/>
+    </request>
+  </interface>
+</protocol>
