#!/usr/bin/env python3
"""Run the required Rust/Python E2E profile with fresh artifacts and private state."""

import argparse
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

from e2e_environment import EVIDENCE, LAVAPIPE, MESA_EGL, ROOT, headless_environment
from installlib.xwayland import verify_companions
from portal_checklib import OwnedProcess
from runtime_artifacts import BINARIES

FEATURES = "udev,e2e,test-apps"


def save(directory, value):
    (directory / "result.json").write_text(json.dumps(value, indent=2) + "\n")


def run_check(name, argv, directory, environment, result):
    print(f"test-e2e: {name}; log {directory / (name + '.log')}", flush=True)
    started = time.monotonic()
    check = {"name": name, "argv": argv}
    result["checks"].append(check)
    with (directory / (name + ".log")).open("x") as log:
        process = OwnedProcess(
            argv, cwd=ROOT, env=environment, stdout=log, stderr=subprocess.STDOUT
        )
        check["pid"] = process.pid
        save(directory, result)
        try:
            while (code := process.poll()) is None:
                time.sleep(0.1)
        finally:
            process.stop(term_timeout=5, kill_timeout=5)
    check.update(returncode=code, seconds=time.monotonic() - started)
    save(directory, result)
    print(f"test-e2e: {name} exited {code}", flush=True)
    return code


def archive_runtime(runtime, directory):
    # Unix sockets cannot be archived; logs, images, XML and ordinary fixture
    # files are retained after their owned processes have stopped.
    def ordinary(member):
        return member if member.isfile() or member.isdir() or member.issym() else None

    with tarfile.open(
        directory / "fixtures.tar.gz", "w:gz", compresslevel=1
    ) as archive:
        archive.add(runtime, arcname="fixtures", filter=ordinary)


def interrupted(signum, _frame):
    raise KeyboardInterrupt(f"signal {signum}")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--evidence",
        type=Path,
        help="fresh directory; defaults to persistent user state",
    )
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="CI only: use the workspace build completed before Xwayland preparation",
    )
    parser.add_argument("--vulkan-icd", type=Path, default=LAVAPIPE)
    parser.add_argument("--egl-vendor", type=Path, default=MESA_EGL)
    options = parser.parse_args(argv)
    parent = Path.home() / ".local/state/hearthspace-e2e"
    directory = (
        (options.evidence or parent / f"run-{time.time_ns()}").expanduser().absolute()
    )
    try:
        directory.parent.mkdir(parents=True, exist_ok=True)
        directory.mkdir(mode=0o700)  # Never replace a previous run's evidence.
    except OSError as error:
        print(
            f"test-e2e: choose a fresh writable evidence directory: {error}",
            file=sys.stderr,
        )
        return 1
    result = {"checks": [], "outcome": "failed"}
    runtime = Path(tempfile.mkdtemp(prefix="hs-e2e-", dir="/tmp"))
    result["runtime"] = str(runtime)
    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous = {sig: signal.signal(sig, interrupted) for sig in signals}
    try:
        for name in ("cargo", "dbus-daemon", "gdbus", "foot", "wayvnc"):
            if shutil.which(name) is None:
                raise RuntimeError(f"{name} is required; see docs/DEPENDENCIES.md")
        for path in (options.vulkan_icd, options.egl_vendor):
            if not path.is_file():
                raise RuntimeError(
                    f"software renderer configuration is missing: {path}"
                )
        overrides = dict(os.environ)
        overrides.update(
            HEARTHSPACE_E2E_VULKAN_ICD=str(options.vulkan_icd.resolve()),
            HEARTHSPACE_E2E_EGL_VENDOR=str(options.egl_vendor.resolve()),
        )
        environment = headless_environment(runtime, inherited=overrides)
        environment.update(
            TMPDIR=str(runtime),
            HEARTHSPACE_E2E="1",
            HEARTHSPACE_REQUIRE_ATSPI="1",
            HEARTHSPACE_REQUIRE_TRAY_LIBRARY="1",
        )
        environment.update(
            {key: str(directory / folder) for key, folder in EVIDENCE.items()}
        )
        metadata = subprocess.run(
            ["cargo", "metadata", "--locked", "--no-deps", "--format-version=1"],
            cwd=ROOT,
            env=environment,
            capture_output=True,
            text=True,
            check=True,
            timeout=30,
        )
        binary_dir = Path(json.loads(metadata.stdout)["target_directory"]) / "debug"
        environment["HEARTHSPACE_BINARY"] = str(binary_dir / "hearthspace")
        result.update(
            head=subprocess.check_output(
                ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
            ).strip(),
            binary_dir=str(binary_dir),
            renderers={
                key: environment[key]
                for key in (
                    "LIBGL_ALWAYS_SOFTWARE",
                    "GSK_RENDERER",
                    "XWAYLAND_NO_GLAMOR",
                    "VK_DRIVER_FILES",
                    "__EGL_VENDOR_LIBRARY_FILENAMES",
                )
            },
        )
        save(directory, result)
        if not options.no_build and run_check(
            "build",
            [
                "cargo",
                "build",
                "--locked",
                "--workspace",
                "--all-targets",
                "--features",
                FEATURES,
            ],
            directory,
            environment,
            result,
        ):
            raise RuntimeError(
                "workspace build failed; tests were not run against stale binaries"
            )
        result["xwayland"] = verify_companions(binary_dir / "hearthspace-compositor")
        result["binary_sha256"] = {}
        for name in (
            *BINARIES,
            "hearthspace",
            "hearthspace-clipboard-test",
            "hearthspace-window-test",
        ):
            with (binary_dir / name).open("rb") as binary:
                result["binary_sha256"][name] = hashlib.file_digest(
                    binary, "sha256"
                ).hexdigest()
        save(directory, result)
        rust = run_check(
            "rust",
            [
                "cargo",
                "test",
                "--locked",
                "--workspace",
                "--all-targets",
                "--features",
                FEATURES,
                "--no-fail-fast",
                "--",
                "--test-threads=1",
            ],
            directory,
            environment,
            result,
        )
        # Finish the independent Python lane even when Rust fails; report both.
        python = run_check(
            "python",
            [sys.executable, "-m", "unittest", "discover", "-s", "scripts/tests", "-v"],
            directory,
            environment,
            result,
        )
        result["outcome"] = "passed" if rust == python == 0 else "failed"
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        result["error"] = str(error)
        print(f"test-e2e: {error}", file=sys.stderr)
    except KeyboardInterrupt as error:
        result.update(outcome="interrupted", error=str(error))
    finally:
        for sig in signals:
            signal.signal(sig, signal.SIG_IGN)
        try:
            archive_runtime(runtime, directory)
            shutil.rmtree(runtime)
            result["runtime_removed"] = True
        except (OSError, tarfile.TarError) as error:
            result.update(outcome="failed", evidence_error=str(error))
        finally:
            save(directory, result)
            for sig, handler in previous.items():
                signal.signal(sig, handler)
            print(f"test-e2e: evidence {directory}", flush=True)
    return (
        130
        if result["outcome"] == "interrupted"
        else (0 if result["outcome"] == "passed" else 1)
    )


if __name__ == "__main__":
    raise SystemExit(main())
